{
  "name": "dsh-shutdown-idle",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "DSH plugin: runs a power action (shutdown / restart / hibernate / sleep / lock / logoff) once every Agent session and background job has gone idle. The toggle never survives a host restart, and the countdown is always cancellable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaoyuqing/dsh-shutdown-idle.git"
  },
  "homepage": "https://github.com/liaoyuqing/dsh-shutdown-idle#readme",
  "bugs": {
    "url": "https://github.com/liaoyuqing/dsh-shutdown-idle/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shutdown",
    "idle"
  ],
  "main": "./host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "host.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/validate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
